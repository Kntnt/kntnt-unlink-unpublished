#: classes/Site_Health.php:91
msgid "Links to deleted pages"
msgstr "Länkar till raderade sidor"

#: classes/Site_Health.php:92
msgid "Published pages whose address redirects"
msgstr "Publicerade sidor vars adress omdirigerar"

#: classes/Site_Health.php:93
msgid "Links currently hidden"
msgstr "Länkar som döljs just nu"

#. translators: 1: title of the deleted page, 2: its address, 3: the pages
#. that link to it.
#: classes/Site_Health.php:162
msgid "%1$s (%2$s), linked from %3$s"
msgstr "%1$s (%2$s), länkas från %3$s"

#: classes/Site_Health.php:172
msgid "No content links to deleted pages"
msgstr "Inget innehåll länkar till raderade sidor"

#: classes/Site_Health.php:172
msgid ""
"Links to deleted pages are hidden from visitors, and none are left in your "
"content."
msgstr ""
"Länkar till raderade sidor döljs för besökare, och inga finns kvar i ditt "
"innehåll."

#: classes/Site_Health.php:174
msgid "Content links to deleted pages"
msgstr "Innehåll länkar till raderade sidor"

#: classes/Site_Health.php:174
msgid ""
"These links are hidden from visitors, but the pages are gone for good. "
"Remove the links or point them elsewhere."
msgstr ""
"Länkarna döljs för besökare, men sidorna är borta för gott. Ta bort länkarna"
" eller låt dem peka någon annanstans."

#. translators: 1: page title with edit link, 2: HTTP status code, 3: redirect
#. target.
#: classes/Site_Health.php:198
msgid "%1$s answers %2$d and redirects to %3$s"
msgstr "%1$s svarar %2$d och omdirigerar till %3$s"

#. translators: %s: page title with edit link.
#: classes/Site_Health.php:205
msgid "%s could not be checked"
msgstr "%s kunde inte kontrolleras"

#: classes/Site_Health.php:212
msgid "Published pages answer at their address"
msgstr "Publicerade sidor svarar på sin adress"

#: classes/Site_Health.php:212
msgid "No published page redirects elsewhere."
msgstr "Ingen publicerad sida omdirigerar någon annanstans."

#: classes/Site_Health.php:214
msgid "Published pages redirect elsewhere"
msgstr "Publicerade sidor omdirigerar någon annanstans"

#: classes/Site_Health.php:214
msgid ""
"These pages are published, but their address redirects – typically because a"
" redirect rule was left in an SEO or redirect plugin while the page was "
"unpublished."
msgstr ""
"Sidorna är publicerade, men deras adress omdirigerar – oftast för att en "
"omdirigeringsregel blev kvar i ett SEO- eller omdirigeringstillägg medan "
"sidan var opublicerad."

#. translators: %d: number of pages.
#: classes/Site_Health.php:256
msgid "Links to %d page are hidden from visitors"
msgid_plural "Links to %d pages are hidden from visitors"
msgstr[0] "Länkar till %d sida döljs för besökare"
msgstr[1] "Länkar till %d sidor döljs för besökare"

#: classes/Site_Health.php:259
msgid ""
"Links to pages that are not published render as plain text. They come back "
"by themselves when the pages are published."
msgstr ""
"Länkar till sidor som inte är publicerade visas som vanlig text. De kommer "
"tillbaka av sig själva när sidorna publiceras."

