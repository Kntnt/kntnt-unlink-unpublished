#. Plugin Name of the plugin
#: kntnt-unlink-unpublished.php
msgid "Kntnt Unlink Unpublished"
msgstr "Kntnt Unlink Unpublished"

#. Description of the plugin
#: kntnt-unlink-unpublished.php
msgid ""
"Renders links to unpublished pages as plain text at render time, and brings "
"them back when the pages are published – without changing stored content."
msgstr ""
"Visar länkar till opublicerade sidor som vanlig text när sidan renderas, och"
" ger tillbaka dem när sidorna publiceras – utan att ändra lagrat innehåll."

#: blocks/notice/block.json
msgctxt "block title"
msgid "Unavailable page notice"
msgstr "Meddelande om otillgänglig sida"

#: blocks/notice/block.json
msgctxt "block description"
msgid ""
"Shows its content only on the address of an unpublished or deleted page. "
"Place it in the 404 template."
msgstr ""
"Visar sitt innehåll bara på adressen till en opublicerad eller raderad sida."
" Placera det i 404-mallen."

#: blocks/notice/block.json
msgctxt "block keyword"
msgid "404"
msgstr "404"

#: blocks/notice/block.json
msgctxt "block keyword"
msgid "unpublished"
msgstr "opublicerad"

#: blocks/notice/block.json
msgctxt "block keyword"
msgid "deleted"
msgstr "raderad"

#. translators: 1: required PHP version, 2: current PHP version.
#: kntnt-unlink-unpublished.php:52
msgid ""
"Kntnt Unlink Unpublished requires PHP %1$s or later. This server runs PHP "
"%2$s. The plugin has been deactivated."
msgstr ""
"Kntnt Unlink Unpublished kräver PHP %1$s eller senare. Servern kör PHP %2$s."
" Tillägget har inaktiverats."

#. translators: %s: error message from the caught exception.
#: kntnt-unlink-unpublished.php:127
msgid "Kntnt Unlink Unpublished failed to initialize: %s"
msgstr "Kntnt Unlink Unpublished kunde inte starta: %s"

