#: kntnt-unlink-unpublished.php
msgid "Kntnt Unlink Unpublished"
msgstr ""

#. Description of the plugin
#: kntnt-unlink-unpublished.php
msgid ""
"Renders links to unpublished pages as plain text at render time, and brings "
"them back when the pages are published – without changing stored content."
msgstr ""

